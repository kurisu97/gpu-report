    <message key="app.title">GPU Report</message>
    <message key="app.tagline">Diagnóstico y capacidades de GPU en Linux</message>

    <message key="help.usage">Uso: {0} [opciones]</message>
    <message key="help.description">Detecta adaptadores gráficos, diagnostica la compatibilidad de códecs de vídeo por hardware y genera recomendaciones de FFmpeg.</message>
    <message key="help.action_title">Acciones:</message>
    <message key="help.option_title">Opciones:</message>
    <message key="help.option.help">Mostrar esta ayuda y salir</message>
    <message key="help.option.version">Mostrar la versión del programa y salir</message>
    <message key="help.option.list_gpu">Listar las GPU detectadas sin diagnóstico completo de códecs</message>
    <message key="help.option.get_report">Ejecutar el diagnóstico completo y mostrar el informe</message>
    <message key="help.option.set_gpu">Seleccionar una GPU por índice, ruta PCI o ID vendor:device</message>
    <message key="help.option.set_local">Establecer el idioma: english, russian, japanese, korean, chinese, spanish</message>
    <message key="help.option.export">Exportar el informe de diagnóstico a un archivo XML</message>
    <message key="help.option.tui">Forzar la interfaz TUI interactiva</message>
    <message key="help.option.no_tui">Mostrar el informe como texto plano</message>
    <message key="help.option.color">Modo de color: auto, always, never</message>
    <message key="help.examples">Ejemplos:</message>
    <message key="help.example.1">{0} --list-gpu</message>
    <message key="help.example.2">{0} --get-report</message>
    <message key="help.example.3">{0} --get-report --set-gpu 0</message>
    <message key="help.example.4">{0} --get-report --set-gpu 0000:01:00.0 --export gpu_info.xml</message>
    <message key="help.example.5">{0} --get-report --set-local=russian</message>
    <message key="help.example.6">{0} --list-gpu --set-gpu 10de:1341</message>
    <message key="help.notes">Notas:</message>
    <message key="help.note.reliability">Se muestra UNKNOWN cuando no se puede verificar la compatibilidad; nunca se sustituye por NO.</message>
    <message key="help.note.optional">La ausencia de herramientas opcionales (vainfo, vulkaninfo, ffmpeg, nvidia-smi) no detiene el programa.</message>
    <message key="help.note.no_root">No se requieren privilegios de root. No se modifican controladores ni ajustes del sistema.</message>
    <message key="help.note.active_probe">El programa no ejecuta codificaciones ni decodificaciones de prueba.</message>
    <message key="help.note.tui">En un terminal interactivo, --get-report abre la TUI. Use --no-tui para texto plano.</message>
    <message key="help.note.export">En la TUI pulse 'e' para exportar XML. Sin TTY use --export &lt;ruta&gt;.</message>

