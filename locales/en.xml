<locale lang="en" name="English">
    <message key="app.title">GPU Report</message>
    <message key="app.tagline">Linux GPU Diagnostic &amp; Capability Reporter</message>

    <message key="help.usage">Usage: {0} [options]</message>
    <message key="help.description">Detect graphics adapters, diagnose hardware video codec support and produce FFmpeg recommendations.</message>
    <message key="help.action_title">Actions:</message>
    <message key="help.option_title">Options:</message>
    <message key="help.option.help">Show this help and exit</message>
    <message key="help.option.version">Show program version and exit</message>
    <message key="help.option.list_gpu">List detected GPUs without full codec diagnostics</message>
    <message key="help.option.get_report">Run full diagnostics and show the report</message>
    <message key="help.option.set_gpu">Select a GPU by index, PCI bus path, or vendor:device ID</message>
    <message key="help.option.set_local">Set interface language: english, russian, japanese, korean, chinese, spanish</message>
    <message key="help.option.export">Export the diagnostic report to an XML file</message>
    <message key="help.option.tui">Force the interactive TUI</message>
    <message key="help.option.no_tui">Print the report as plain text</message>
    <message key="help.option.color">Color mode: auto, always, never</message>
    <message key="help.examples">Examples:</message>
    <message key="help.example.1">{0} --list-gpu</message>
    <message key="help.example.2">{0} --get-report</message>
    <message key="help.example.3">{0} --get-report --set-gpu 0</message>
    <message key="help.example.4">{0} --get-report --set-gpu 0000:01:00.0 --export gpu_info.xml</message>
    <message key="help.example.5">{0} --get-report --set-local=russian</message>
    <message key="help.example.6">{0} --list-gpu --set-gpu 10de:1341</message>
    <message key="help.notes">Notes:</message>
    <message key="help.note.reliability">UNKNOWN is reported when hardware support cannot be verified; it is never replaced with NO.</message>
    <message key="help.note.optional">Missing optional tools (vainfo, vulkaninfo, ffmpeg, nvidia-smi) do not stop the program.</message>
    <message key="help.note.no_root">Root privileges are not required. No drivers or system settings are modified.</message>
    <message key="help.note.active_probe">The program does not run test encodes or decodes.</message>
    <message key="help.note.tui">In an interactive terminal, --get-report opens the TUI. Use --no-tui for plain text.</message>
    <message key="help.note.export">In the TUI press 'e' to export XML. Without a TTY, use --export &lt;path&gt;.</message>

