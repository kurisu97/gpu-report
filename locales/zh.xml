    <message key="app.title">GPU Report</message>
    <message key="app.tagline">Linux GPU 诊断与能力报告工具</message>

    <message key="help.usage">用法: {0} [选项]</message>
    <message key="help.description">检测图形适配器，诊断硬件视频编解码器支持情况，并生成 FFmpeg 编码建议。</message>
    <message key="help.action_title">操作:</message>
    <message key="help.option_title">选项:</message>
    <message key="help.option.help">显示此帮助并退出</message>
    <message key="help.option.version">显示程序版本并退出</message>
    <message key="help.option.list_gpu">列出检测到的 GPU，不执行完整编解码诊断</message>
    <message key="help.option.get_report">执行完整诊断并显示报告</message>
    <message key="help.option.set_gpu">按索引、PCI 总线路径或 vendor:device ID 选择 GPU</message>
    <message key="help.option.set_local">设置界面语言: english, russian, japanese, korean, chinese, spanish</message>
    <message key="help.option.export">将诊断报告导出为 XML 文件</message>
    <message key="help.option.tui">强制打开交互式 TUI</message>
    <message key="help.option.no_tui">以纯文本输出报告</message>
    <message key="help.option.color">颜色模式: auto, always, never</message>
    <message key="help.examples">示例:</message>
    <message key="help.example.1">{0} --list-gpu</message>
    <message key="help.example.2">{0} --get-report</message>
    <message key="help.example.3">{0} --get-report --set-gpu 0</message>
    <message key="help.example.4">{0} --get-report --set-gpu 0000:01:00.0 --export gpu_info.xml</message>
    <message key="help.example.5">{0} --get-report --set-local=russian</message>
    <message key="help.example.6">{0} --list-gpu --set-gpu 10de:1341</message>
    <message key="help.notes">注意:</message>
    <message key="help.note.reliability">无法确认硬件支持时显示 UNKNOWN，绝不会用 NO 代替。</message>
    <message key="help.note.optional">缺少可选工具（vainfo、vulkaninfo、ffmpeg、nvidia-smi）不会导致程序终止。</message>
    <message key="help.note.no_root">不需要 root 权限。不会修改驱动或系统设置。</message>
    <message key="help.note.active_probe">程序不会执行测试编码或解码。</message>
    <message key="help.note.tui">在交互式终端中，--get-report 会打开 TUI。使用 --no-tui 输出纯文本。</message>
    <message key="help.note.export">在 TUI 中按 'e' 导出 XML。无 TTY 时使用 --export &lt;路径&gt;。</message>

